# 複製成 .env 後填入。 .env 不要上傳到 GitHub。

# LLM：anthropic / openai / azure / none（none = 不呼叫 LLM，只回最相關段落）
LLM_PROVIDER=none
# LLM_MODEL=            # 不填就用預設模型

# Claude
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<你的資源名稱>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=     # Azure 上的「部署名稱」，不是模型名稱
# AZURE_OPENAI_API_VERSION=2024-10-21

# LINE Messaging API（LINE Developers Console）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
